{
  "name": "@_latest-es/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "bun --bun --env-file=../../apps/server/.env drizzle-kit studio --config=drizzle.config.ts --host=0.0.0.0 --port=4983",
    "db:push": "bun --bun --env-file=../../apps/server/.env drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "bun --bun --env-file=../../apps/server/.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate:deploy": "bun --bun --env-file=../../apps/server/.env drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "bun --bun --env-file=../../apps/server/.env drizzle-kit studio --config=drizzle.config.ts",
    "db:migrate": "bun --bun --env-file=../../apps/server/.env drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@_latest-es/env": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@_latest-es/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
