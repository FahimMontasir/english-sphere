NODE_ENV=development
PORT=3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8081

# Local development and automated web-test identity. Never reuse in production.
BOOTSTRAP_USER_NAME=English Sphere Test Learner
BOOTSTRAP_USER_EMAIL=learner@english-sphere.local
BOOTSTRAP_USER_PASSWORD=local-test-password

POSTGRES_DB=english_sphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:local-postgres-password@localhost:5433/english_sphere

REDIS_PASSWORD=local-redis-password
REDIS_PORT=6380
REDIS_URL=redis://:local-redis-password@localhost:6380

S3_ACCESS_KEY_ID=english-sphere-dev
S3_SECRET_ACCESS_KEY=local-storage-secret-key-change-me
S3_BUCKET=english-sphere-private
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=local-garage-admin-token
GARAGE_METRICS_TOKEN=local-garage-metrics-token
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_WEBUI_HOST=localhost
GARAGE_WEBUI_PORT=3909
GARAGE_WEBUI_USERNAME=admin
GARAGE_WEBUI_PASSWORD=local-storage-password
GARAGE_WEBUI_AUTH_USER_PASS=admin:local-storage-password

DRIZZLE_STUDIO_URL=https://local.drizzle.studio
