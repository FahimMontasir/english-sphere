{
  "name": "_latest-es",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@elysiajs/eden": "1.4.9",
      "@react-native-community/netinfo": "12.0.1",
      "@tanstack/react-query": "5.102.2",
      "@types/bun": "^1.3.14",
      "better-auth": "1.6.30",
      "@better-auth/expo": "1.6.30"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "test": "bun run test:unit && bun run test:routes",
    "test:unit": "bun test packages/__env__/__tests__/unit packages/__shared__/__tests__/unit packages/learning-content/__tests__/unit packages/learning-content/__tests__/native",
    "test:routes": "bun test packages/learning-content/__tests__/integration",
    "test:e2e": "maestro test apps/native/.maestro/web",
    "test:e2e:native": "maestro test apps/native/.maestro/materials.yaml",
    "dev:native": "vp run --filter native dev",
    "dev:server": "vp run --filter @_latest-es/server dev",
    "db:push": "vp run --filter @_latest-es/db db:push",
    "db:studio": "vp run --filter @_latest-es/db db:studio",
    "db:generate": "vp run --filter @_latest-es/db db:generate",
    "db:migrate": "vp run --filter @_latest-es/db db:migrate",
    "db:start": "vp run --filter @_latest-es/db db:start",
    "db:watch": "vp run --filter @_latest-es/db db:watch",
    "db:stop": "vp run --filter @_latest-es/db db:stop",
    "db:down": "vp run --filter @_latest-es/db db:down"
  },
  "devDependencies": {
    "@_latest-es/config": "workspace:*",
    "@types/bun": "catalog:",
    "rolldown": "1.2.0",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "packageManager": "bun@1.3.14"
}
